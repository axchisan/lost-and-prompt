# Maintainer: axchisan <https://github.com/axchisan>
pkgname=lost-and-prompt-bin
_pkgname=lost-and-prompt
pkgver=0.2.0
pkgrel=1
pkgdesc="Find, organize and resume all your Claude Code sessions, from every folder"
arch=('x86_64')
url="https://github.com/axchisan/lost-and-prompt"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'hicolor-icon-theme')
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!strip' '!debug')
source=("LostAndPrompt-$pkgver-linux-amd64.deb::$url/releases/download/v$pkgver/LostAndPrompt-$pkgver-linux-amd64.deb"
        "LICENSE-$pkgver::https://raw.githubusercontent.com/axchisan/lost-and-prompt/v$pkgver/LICENSE")
noextract=("LostAndPrompt-$pkgver-linux-amd64.deb")
sha256sums=('3a4b43a5ae02ba9b9b1043e2a9751d405005db4af356dc2e465b009cefb3bb8f'
            '4b4fa319bede116c8b1350477878b22efa9c821397ba98967ce0522731413bd9')

package() {
  bsdtar -xOf "LostAndPrompt-$pkgver-linux-amd64.deb" data.tar.gz | bsdtar -xf - -C "$pkgdir"
  # Nombre del lanzador sin espacios ni &
  mv "$pkgdir/usr/share/applications/Lost & Prompt.desktop" "$pkgdir/usr/share/applications/$_pkgname.desktop"
  install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
