    "Al continuarla, Claude leerá todo lo que trae. Importa solo sesiones de personas de confianza.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you continue it, Claude will read everything it brings. Only import sessions from people you trust."
          }
        }
      }
    },
